#!/usr/sbin/nft -f
# Limits new web connections per source. Load with `sudo nft -f`, and read
# docs/setup.md first. It only drops excess connections to ports 80 and 443: every
# other port and existing connection is untouched, so SSH can't be locked out.
# An office behind one NAT address counts as one source, so raise the rates if needed.

table inet dfipam_flood {
    set seen4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; size 65536; }
    set seen6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; size 65536; }

    chain input {
        type filter hook input priority filter - 10; policy accept;
        tcp dport { 80, 443 } ct state new add @seen4 { ip saddr limit rate over 100/second burst 200 packets } drop
        tcp dport { 80, 443 } ct state new add @seen6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 100/second burst 200 packets } drop
    }
}
