# /etc/df-ipam/agent.env on each agent host, owned by root, group dfipam-agent, mode 640.
AGENT_API_URL=https://ipam.example.com
# One-time token from Discovery Centre. Delete this line after the first start.
AGENT_REGISTRATION_TOKEN=
AGENT_CREDENTIAL_FILE=/var/lib/df-ipam-agent/agent.credential
AGENT_POLL_SECONDS=30
