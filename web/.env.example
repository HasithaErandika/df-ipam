# Copy to .env. The anon key is public by design. Never add the service role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Leave empty: the dev server and Nginx both pass /api to the backend, so the app
# and API share one address, which Microsoft sign-in's cookie needs.
VITE_API_URL=
