# The site itself, used by both the HTTP and the TLS server.
# An office behind one NAT address counts as one client, so raise these if
# real people start seeing 429.
limit_conn dfipam_conn 50;

# Slow clients can't hold connections open.
client_header_timeout 10s;
client_body_timeout 15s;
send_timeout 30s;
keepalive_timeout 30s;
keepalive_requests 1000;
large_client_header_buffers 4 16k;
reset_timedout_connection on;

# The web app reads this format, so people see a clear message.
error_page 429 = @limited;
location @limited {
    internal;
    default_type application/json;
    add_header Retry-After 1 always;
    return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests. Try again shortly.","correlationId":""}}';
}

# Who may reach the site. Exactly one of these files.
include /etc/nginx/rules/access.conf;

add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${SUPABASE_URL}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

# Most requests are small. The routes that take files set their own limit below.
client_max_body_size 2m;

root /usr/share/nginx/html;
index index.html;

location / {
    limit_req zone=dfipam_static burst=100 nodelay;
    try_files $uri /index.html;
}

location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
}

location /api/ {
    limit_req zone=dfipam_api burst=60 nodelay;
    proxy_pass http://dfipam_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# Import files reach 5 MB, which is about 7 MB as base64 in the request.
location = /api/v1/imports {
    limit_req zone=dfipam_api burst=60 nodelay;
    client_max_body_size 8m;
    proxy_pass http://dfipam_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

# Agents get their own, tighter limit and may sit on different networks.
location = /api/v1/agent-api/register {
    include /etc/nginx/rules/agents.conf;
    limit_req zone=dfipam_agent burst=2 nodelay;
    proxy_pass http://dfipam_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/v1/agent-api/ {
    include /etc/nginx/rules/agents.conf;
    limit_req zone=dfipam_agent burst=20 nodelay;
    client_max_body_size 2m;
    proxy_pass http://dfipam_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Health checks stay on the server itself.
location = /health { allow 127.0.0.1; deny all; proxy_pass http://dfipam_api; }
location = /ready  { allow 127.0.0.1; deny all; proxy_pass http://dfipam_api; }
