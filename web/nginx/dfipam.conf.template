# Shared settings. Docker fills in the values, and the site comes from
# site-http.conf or site-tls.conf.
limit_req_zone $binary_remote_addr zone=dfipam_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=dfipam_agent:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=dfipam_static:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=dfipam_conn:10m;
limit_req_status 429;
limit_conn_status 429;

upstream dfipam_api {
    server backend:8080;
    keepalive 16;
}

# Docker's health check only.
server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /nginx-health { return 200 "ok\n"; }
}

include /etc/nginx/site/site.conf;
