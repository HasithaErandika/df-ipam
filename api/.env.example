# Copy to .env. Never commit .env.
APP_ENV=development
API_LISTEN_ADDR=127.0.0.1:8080
LOG_LEVEL=info
# Web origins allowed to call the API, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Flood protection. Addresses allowed to state the client's address, and the most
# requests running at once. In Docker the proxy is the web container, set by compose.
TRUSTED_PROXIES=127.0.0.1,::1
API_MAX_IN_FLIGHT=200
# On a server, publish only the web container on 80 and 443.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Local port of the web container.
# WEB_PORT=8088
# Linux only: let the backend share the host's network so discovery sees MAC
# addresses and the real gateway (docs/product/discovery.md#mac-addresses). See docker-compose.hostnet.yml.
HOST_NETWORK=false
# The Docker network. Change these if they clash with a company range.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1

# Local PostgreSQL in Docker. `make db-up` starts it. Letters and digits only in these
# passwords, because they go into connection URLs. They take effect when the data volume
# is first created: after that, change them in the database too, or run `make db-reset`.
POSTGRES_DB=dfipam
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me
DFIPAM_APP_PASSWORD=change-me-too

# Connections for commands run on this machine, such as `make api` and `make test-db`.
# The containers build their own URLs from the values above.
DATABASE_URL=postgres://dfipam_app:change-me-too@127.0.0.1:5432/dfipam?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/dfipam?sslmode=disable

# Host port for the API container.
API_PORT=8080
# Encrypted backups: the GPG key to encrypt to. See deploy/scripts/backup.sh.
BACKUP_GPG_RECIPIENT=

# Pool size for processes run on this machine. The backend container uses 30.
DB_MAX_CONNS=5

# Master key for stored credentials, such as the FortiGate API token: `openssl rand -base64 32`. Keep a copy apart
# from database backups. Without it, stored credentials can't be recovered.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=1
# Only during a rotation: the key one version older.
SECRET_ENCRYPTION_KEY_PREVIOUS=

# Public URL of the web app, used for links in emails.
APP_BASE_URL=http://localhost:5173
# Microsoft Entra ID sign-in (off until all three are set). Register an app in
# Entra ID: single tenant, web redirect URI APP_BASE_URL/api/v1/auth/microsoft/callback.
# The secret stays here only. See docs/engineering/authentication.md.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Only these email domains may sign in with Microsoft, comma-separated.
AUTH_ALLOWED_EMAIL_DOMAINS=dialogfinance.lk
# Optional: ENTRA_REDIRECT_URL overrides APP_BASE_URL/api/v1/auth/microsoft/callback;
# ENTRA_AUTHORITY overrides https://login.microsoftonline.com.

# Network link attachments. Docker sets /data/attachments (the link-files volume);
# outside Docker the default is api/data/attachments.
# ATTACHMENTS_DIR=

# Email. Settings > System has the on/off switch (off by default). Leave SMTP_HOST empty
# and email stays off whatever the switch says; in-app notifications still work. Port 465 uses TLS; others need STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
