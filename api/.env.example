# Copy to .env. Never commit .env.
APP_ENV=development
API_LISTEN_ADDR=127.0.0.1:8080
LOG_LEVEL=info
# Web origins allowed to call the API, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Flood protection. Addresses allowed to state the client's address, and the most
# requests running at once. In Docker the proxy is DOCKER_GATEWAY, set by compose.
TRUSTED_PROXIES=127.0.0.1,::1
API_MAX_IN_FLIGHT=200
# The Docker network. Change these if they clash with a company range.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1

# Supabase provides sign-in. The service role key is secret: it stays in this file, never in web/.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local PostgreSQL in Docker. `make db-up` starts it. Letters and digits only in these
# passwords, because they go into connection URLs. They take effect when the data volume
# is first created: after that, change them in the database too, or run `make db-reset`.
POSTGRES_DB=dfipam
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me
DFIPAM_APP_PASSWORD=change-me-too

# Connections for commands run on this machine, such as `make api` and `make test-db`.
# The containers build their own URLs from the values above.
DATABASE_URL=postgres://dfipam_app:change-me-too@127.0.0.1:5432/dfipam?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/dfipam?sslmode=disable

# Supabase database, for testing only: `make test-db-supabase`, `make migrate-supabase`.
# URL-encode passwords.
SUPABASE_DATABASE_URL=
SUPABASE_MIGRATION_DATABASE_URL=

# Host port for the API container.
API_PORT=8080
# Encrypted backups: the GPG key to encrypt to. See deploy/scripts/backup.sh.
BACKUP_GPG_RECIPIENT=

# Pool size for API and worker processes run on this machine. Containers use 20 and 10.
# Against Supabase's session pooler, keep the total of all processes below 15.
DB_MAX_CONNS=5

# Master key for integration credentials: `openssl rand -base64 32`. Keep a copy apart
# from database backups. Without it, stored credentials can't be recovered.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=1
# Only during a rotation: the key one version older.
SECRET_ENCRYPTION_KEY_PREVIOUS=

# Outbound policy for FortiGate and vCenter URLs. With no hosts set, every URL is refused.
# Hosts are comma separated; start with a dot to allow a domain's subdomains.
INTEGRATION_ALLOWED_HOSTS=
# Private ranges those hosts may resolve to, as CIDRs. Others are refused.
INTEGRATION_ALLOWED_PRIVATE_RANGES=
# PEM file for a private certificate authority. TLS verification is never turned off.
INTEGRATION_CA_FILE=

# Worker: public URL of the web app, used for links in emails.
APP_BASE_URL=http://localhost:5173
# Worker email. Leave SMTP_HOST empty to keep email off: in-app alerts still work,
# and unsent email is dropped after seven days. Port 465 uses TLS; others need STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
