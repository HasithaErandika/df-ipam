# Copy to .env. Never commit .env.
APP_ENV=development
API_LISTEN_ADDR=127.0.0.1:8080
LOG_LEVEL=info
# Web origins allowed to call the API, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase. The service role key is secret: it stays in this file, never in web/.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database: the keys above can't open a Postgres connection, so these are required.
# DATABASE_URL uses the dfipam_app role; the others use postgres. URL-encode passwords.
DATABASE_URL=
MIGRATION_DATABASE_URL=


# Worker: public URL of the web app, used for links in emails.
APP_BASE_URL=http://localhost:5173
# Worker email. Leave SMTP_HOST empty to keep email off: in-app alerts still work,
# and unsent email is dropped after seven days. Port 465 uses TLS; others need STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
